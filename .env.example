# ─── API Keys (required for full functionality) ──────────────────────────────

# OpenAI API key for GPT-4o (NLP + metadata extraction)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY= ...

# YouTube Data API v3 key (for views, likes, captions, description)
# Get one at: https://console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=...

# ─── Model Configuration ─────────────────────────────────────────────────────

# Whisper model: tiny | base | small | medium | large
# 'base' is the recommended default (fast + good accuracy)
WHISPER_MODEL=base

# OpenAI model (gpt-4o is recommended; gpt-3.5-turbo works but less accurate)
OPENAI_MODEL=gpt-4o

# HuggingFace CLIP model
CLIP_MODEL=openai/clip-vit-base-patch32

# ─── Processing Configuration ────────────────────────────────────────────────

# Directory for temporary downloaded files (auto-created)
TEMP_DIR=./temp

# Maximum number of frames to extract from each trailer
MAX_FRAMES=30

# Interval between extracted frames (seconds)
FRAME_INTERVAL_SECONDS=2.5

# ─── Server Configuration ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
